# Generate local JWT/database/Redis secrets with: node scripts/setup-local-secrets.mjs
NODE_ENV=production
VIDFORGE_PROFILE=personal
PORT=3001
WEB_BASE_URL=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=
JWT_EXPIRES_IN=7d
DB_HOST=127.0.0.1
DB_PORT=55432
DB_USER=vidforge
DB_PASSWORD=
DB_NAME=vidforge
DB_TLS=false
DB_SYNCHRONIZE=false
REDIS_URL=
QUEUE_INLINE_FALLBACK=false
PROCESS_ROLE=api
# Run a separate PROCESS_ROLE=media-worker process for creation/export/material jobs.
# Run a separate PROCESS_ROLE=agent-worker process for agent jobs.
STORAGE_ROOT=storage
PROCESSING_ROOT=.processing
LLM_GATEWAY_URL=http://127.0.0.1:4000
LLM_GATEWAY_KEY=
MEDIA_GATEWAY_URL=http://127.0.0.1:8080
MEDIA_GATEWAY_KEY=
TEXT_MODEL_ALIAS=openai-main
VISION_MODEL_ALIAS=openai-main
IMAGE_MODEL_ALIAS=image-main
VIDEO_MODEL_ALIAS=video-main
VOICE_MODEL_ALIAS=voice-main
# Choose a voice supported by the configured alias (for example Rachel).
SPEECH_VOICE=
# Exact origins used in signed gateway output URLs; no wildcards or redirects.
ASSET_STORE_ORIGINS=http://127.0.0.1:9000
# Optional loopback-only local embeddings. Keyword search works without this.
# LOCAL_EMBEDDING_URL=http://127.0.0.1:11434/api/embeddings
SEED_DEMO_USER=false
TELEMETRY_ENABLED=false
